# Lab 4 serving baseline. Fill locally; never commit cloud.env or credentials.
# Serving settings work independently of the host-side deployment settings below.
CLOUD_PROVIDER=azure
MLFLOW_TRACKING_URI=<workspace-mlflow-tracking-uri>
MODEL_REGISTRY_NAME=itcs355-u6688124
MODEL_VERSION=1

# Task 2.4: host/CI deployment only. Uncomment and fill after resources are prepared.
# deploy needs existing Lab 4-tagged environment and runtime identity; it grants no roles.
# SERVING_IMAGE must be the tested image's repository@sha256:digest, never a tag.
# SERVING_ALLOWED_IP is the client /32 kept after CI; keep it in an environment secret.
# CI discovers SERVING_RUNNER_IP, adds it for smoke, then runs make restore-access.
# If the runner is lost, run make restore-access manually with the deployment config.
# PROJECT_ID=<course-resource-group>
# REGION=<region>
# AZURE_SUBSCRIPTION_ID=<subscription-id>
# AZURE_ML_WORKSPACE=<existing-model-workspace>
# CONTAINER_REGISTRY=<registry-host/lab4-repository>
# IDENTITY_REF=<runtime-identity-principal-id>
# SERVING_IMAGE=<registry-host/lab4-repository@sha256:digest>
# ENDPOINT_NAME=<lab4-staging-app-name>
# AZURE_CONTAINERAPPS_ENVIRONMENT=<lab4-environment-name>
# AZURE_MANAGED_IDENTITY_ID=<runtime-identity-resource-id>
# SERVING_ALLOWED_IP=<your-public-ipv4/32>
# SERVING_RUNNER_IP=<temporary-runner-public-ipv4/32>
# Leave SERVING_RUNNER_IP unset for normal local deployment.
# SERVING_INSTANCE=0.5cpu-1Gi
