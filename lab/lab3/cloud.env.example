# Lab 3 configuration template. Never add credentials here or commit cloud.env.
CLOUD_PROVIDER=azure
# PROJECT_ID is the existing resource-group name, not the subscription ID.
PROJECT_ID=itcs355-<studentid>
REGION=<region>

# Reuse the workspace that holds the Lab 2 model. No training compute is needed.
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_ML_WORKSPACE=<workspace-name>
MLFLOW_TRACKING_URI=<workspace-mlflow-tracking-uri>
# Registered in Lab 2; use a numbered version, not latest or Staging.
MODEL_REGISTRY_NAME=itcs355-u6688124
MODEL_VERSION=1

# Reuse shared storage and ACR, keeping Lab 3 paths separate.
BLOB_URI=https://<account>.blob.core.windows.net/<private-container>/lab3
CONTAINER_REGISTRY=<registry>.azurecr.io/itcs355-lab3
# Configure the serving identity when preparing deployment; never put a token here.
IDENTITY_REF=<serving-identity-principal-id>

# Task 2 deployment: fill these only after preparing the Lab 3 environment/identity.
# The environment must already exist; deploy() does not create it or grant roles.
AZURE_CONTAINERAPPS_ENVIRONMENT=<lab3-environment-name>
# Resource ID, NOT the principal ID above. deploy() reads its client ID for the runtime.
AZURE_MANAGED_IDENTITY_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.ManagedIdentity/userAssignedIdentities/<lab3-identity-name>
SERVING_IMAGE=<registry>.azurecr.io/itcs355-lab3@sha256:<64-hex-digest>
ENDPOINT_NAME=<lab3-container-app-name>
SERVING_INSTANCE=0.5cpu-1Gi
# One public IPv4 address (/32). No default open-to-everyone ingress.
SERVING_ALLOWED_IP=<your-public-ip>/32
