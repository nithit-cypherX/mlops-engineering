# Copy to cloud.env when configuring Lab 2. Never put credentials in this file.
CLOUD_PROVIDER=azure
# PROJECT_ID is the existing Azure resource-group name, not the subscription ID.
PROJECT_ID=itcs355-<studentid>
REGION=<region>

AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_ML_WORKSPACE=<workspace-name>
AZURE_ML_COMPUTE=<compute-name>

# Reuse the existing storage account and ACR. Keep Lab 2 outputs separate.
BLOB_URI=https://<account>.blob.core.windows.net/<workspace-private-container>/lab2
# Input: BLOB_URI/data/sensors.csv. Future job outputs: BLOB_URI/runs/<job-id>/.
CONTAINER_REGISTRY=<registry>.azurecr.io/itcs355-lab2

# Copy mlflow_tracking_uri from the workspace. Managed logging is not yet tested.
# Local-only development can override this with sqlite:///reports/mlflow.db.
MLFLOW_TRACKING_URI=<workspace-mlflow-tracking-uri>
MODEL_REGISTRY_NAME=itcs355-<studentid>
# Principal/object ID of the compute's system-assigned identity, not a secret.
IDENTITY_REF=<compute-managed-identity-principal-id>
BUDGET_LIMIT_THB=150
